<?xml version="1.0"?>
<package format="3">
  <name>hci_ff_msgs</name>
  <version>0.1.0</version>
  <description>ROS 2 copies of the Astrobee command and ack messages used by the HCI bridge. Personal project, not NASA flight code.</description>
  <maintainer email="hci@example.com">HCI crew assist</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
